# ---------------------------------------------------------------------------
# RozgarPK environment contract. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development                 # development | staging | production
APP_NAME=RozgarPK
LOG_LEVEL=INFO
LOG_JSON=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Comma separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://rozgar:rozgar@localhost:5432/rozgar
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false                     # MUST be true behind HTTPS in production
COOKIE_SAMESITE=lax
# Bootstrap admin created by `make seed-admin` (dev/staging convenience only)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Google OAuth (optional; login button hides itself when unset) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Email provider --------------------------------------------------------
# EMAIL_PROVIDER: console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="RozgarPK <no-reply@rozgar.pk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=

# --- Object storage (S3 compatible: AWS S3, R2, MinIO) ---------------------
STORAGE_PROVIDER=none                   # none | s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=application/pdf,image/png,image/jpeg

# --- Search backend --------------------------------------------------------
SEARCH_BACKEND=postgres                 # postgres | opensearch
OPENSEARCH_URL=
OPENSEARCH_INDEX=jobs

# --- AI layer (all optional; platform degrades gracefully) -----------------
AI_ENABLED=false
AI_PROVIDER=null                        # null | openai | gemini | anthropic | local
AI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LOCAL_AI_BASE_URL=

# --- Ingestion -------------------------------------------------------------
INGEST_USER_AGENT=RozgarPKBot/1.0 (+https://rozgar.pk/bot; aggregation with attribution)
INGEST_HTTP_TIMEOUT=25
INGEST_MAX_RETRIES=4
INGEST_RETRY_BASE_SECONDS=15
INGEST_GLOBAL_CONCURRENCY=4
ENABLE_SEED_SOURCES=false               # dev only — must stay false in production

# --- Source credentials (per connector; leave blank to keep source disabled)
GITHUB_TOKEN=                           # optional: raises GitHub API rate limit 60→5000/h

# --- Trust & internal calls ------------------------------------------------
# Hosts whose X-Forwarded-For / X-Real-IP headers may be believed. Comma separated IPs or
# CIDRs; "*" trusts any peer (only safe when the API is not publicly reachable). Empty means
# the header is ignored entirely and the socket peer is used, which is the safe default.
TRUSTED_PROXIES=
# Shared secret so server-rendered pages are not all charged to one rate-limit bucket.
# Server-side only - never expose this to the browser. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=180

# --- Frontend (apps/web) ---------------------------------------------------
# Browser calls the API through the Next.js rewrite at /api, so this stays relative.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side origin the Next.js server uses to reach the API container
API_INTERNAL_URL=http://localhost:8000

# Optional CA bundle for outbound requests. Use "system" behind a TLS-inspecting proxy,
# or an absolute path to a PEM bundle. Empty = certifi default. Verification is never disabled.
INGEST_CA_BUNDLE=
